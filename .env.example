# ==============================================================================
# Security System - Local Development Environment Configuration
# ==============================================================================
# This file provides ALL environment variables consumed by docker-compose.yml
# and the underlying services. Never commit this file to version control.
# Copy .env.example to .env and customize as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL / TimescaleDB
# ------------------------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=security_system
DB_HOST=timescaledb
DB_PORT=5432

# ------------------------------------------------------------------------------
# Django API Service
# ------------------------------------------------------------------------------
# SECURITY WARNING: Change this to a long, random value in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-local-dev-key-change-me-in-production

# Set to 0 in production for security.
DEBUG=1

# Comma-separated list of allowed hosts, or * to allow all (dev only).
DJANGO_ALLOWED_HOSTS=*

# ------------------------------------------------------------------------------
# Redis Cache
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/1

# ------------------------------------------------------------------------------
# MinIO Object Storage
# ------------------------------------------------------------------------------
STORAGE_BACKEND=minio
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=security-system
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ------------------------------------------------------------------------------
# API Gateway (Node.js)
# ------------------------------------------------------------------------------
# SECURITY WARNING: Change this to a long, random value in production.
JWT_SECRET=a-secure-secret-for-jwt-that-is-long-and-random
API_SERVICE_URL=http://api:8000
GATEWAY_PORT=3000

# ------------------------------------------------------------------------------
# Stream Processor
# ------------------------------------------------------------------------------
# ZeroMQ endpoint where the stream processor publishes video frames.
ZMQ_STREAM_PUB_URL=tcp://*:5555

# Comma-separated list of RTSP URLs to ingest. Update with your camera credentials.
RTSP_URLS=rtsp://user:password@192.168.1.64:554/Streaming/Channels/101,rtsp://user:password@192.168.1.64:554/Streaming/Channels/201,rtsp://user:password@192.168.1.64:554/Streaming/Channels/301

# ------------------------------------------------------------------------------
# Person Detector (AI Service)
# ------------------------------------------------------------------------------
# ZeroMQ subscriber URL where frames are consumed from.
ZMQ_DETECTOR_SUB_URL=tcp://stream_processor:5555

# ZeroMQ publisher URL where detection events are published.
ZMQ_DETECTOR_PUB_URL=tcp://*:5556

# Minimum contour area (in pixels) to consider as significant motion.
MIN_CONTOUR_AREA=500

# Confidence threshold for person detections (0.0 - 1.0).
DETECTION_CONFIDENCE_THRESHOLD=0.85

# ------------------------------------------------------------------------------
# Event Handler
# ------------------------------------------------------------------------------
# ZeroMQ subscriber URL where detection events are consumed from.
ZMQ_EVENT_SUB_URL=tcp://person_detector:5556