# ==============================================================================
# Django API Service - Local (Non-Docker) Development Config
# ==============================================================================
# This file is only needed if you run the Django app OUTSIDE of Docker
# (e.g., `python manage.py runserver` from your host machine).
# When running via docker-compose, environment variables come from the root .env.
# ==============================================================================

SECRET_KEY=django-insecure-local-dev-key
DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database - points to localhost when running outside Docker
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=security_system

# Redis - points to localhost when running outside Docker
REDIS_URL=redis://localhost:6379/1

# Storage
STORAGE_BACKEND=local
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=security-system