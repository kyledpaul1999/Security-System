# ==============================================================================
# API Gateway - Local (Non-Docker) Development Config
# ==============================================================================
# This file is only needed if you run the gateway OUTSIDE of Docker.
# When running via docker-compose, environment variables come from the root .env.
# ==============================================================================

JWT_SECRET=a-secure-secret-for-jwt-that-is-long-and-random
API_SERVICE_URL=http://localhost:8000
GATEWAY_PORT=3000
NODE_ENV=development